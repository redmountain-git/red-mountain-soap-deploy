---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title="Wholesale and hospitality"
  description="Local wholesale and hospitality soap from Red Mountain Soap in Ivins, Utah."
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">For shops, stays & thoughtful hosts</p>
      <h1>A local detail guests can actually use.</h1>
      <p>
        Place-based soap for Southern Utah retail shelves, vacation rentals, welcome baskets, and small hospitality programs.
      </p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell split-grid">
      <div>
        <p class="eyebrow">The offer</p>
        <h2>Start with a sample, not a commitment.</h2>
        <p class="lede">
          The first conversation is about your shelf, guests, reorder rhythm, and price point. If the fit is real, we can test a small order before pretending anyone knows the monthly volume.
        </p>
        <a
          class="button"
          href={`mailto:${siteConfig.email}?subject=Wholesale%20or%20hospitality%20inquiry&body=Business%20name%3A%0ABusiness%20type%3A%0ALocation%3A%0AWhat%20you%27re%20considering%3A%0A`}
        >
          Request a sample conversation
        </a>
      </div>
      <aside class="content-card">
        <h3>Useful information to include</h3>
        <ul class="detail-list">
          <li>Business name, location, and type</li>
          <li>Retail shelf, guest amenity, welcome gift, or another use</li>
          <li>Approximate monthly stays, customers, or unit volume</li>
          <li>Preferred bar size, packaging, and target price</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <header class="section-heading">
        <div>
          <p class="eyebrow">A practical local program</p>
          <h2>What we are building toward.</h2>
        </div>
      </header>
      <div class="content-grid">
        <article class="content-card">
          <div class="content-card__icon">01</div>
          <h3>Retail-ready</h3>
          <p>Clear scent stories, consistent packaging, case information, and a compact line that does not consume the whole shelf.</p>
        </article>
        <article class="content-card">
          <div class="content-card__icon">02</div>
          <h3>Hospitality-minded</h3>
          <p>Useful local character for guest stays, with replenishment and unit economics discussed before quantities are promised.</p>
        </article>
        <article class="content-card">
          <div class="content-card__icon">03</div>
          <h3>Traceable batches</h3>
          <p>Production, cure status, and finished inventory remain tied to batch records behind the scenes.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--clay">
    <div class="shell split-grid">
      <div>
        <p class="eyebrow">Before the line sheet is final</p>
        <h2>Commercial details still require approval.</h2>
      </div>
      <div>
        <p>
          Wholesale pricing, case packs, minimums, lead times, sample policy, UPC requirements, and payment terms will not be published until production capacity and finished packaging have been validated.
        </p>
        <a class="text-link" href="/contact/">Contact Red Mountain Soap →</a>
      </div>
    </div>
  </section>
</BaseLayout>
