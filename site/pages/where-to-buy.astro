---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
---

<BaseLayout
  title="Where to buy"
  description="Find Red Mountain Soap at local markets, stockists, and by appointment in Southern Utah."
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Markets, stockists & pickup</p>
      <h1>Find us in Southern Utah.</h1>
      <p>
        Confirmed market dates and dependable stockists will appear here. The private Ivins production address is not a walk-in storefront.
      </p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell">
      <aside class="catalog-notice">
        <p>
          <strong>No public locations are listed yet.</strong> We will add a stockist only after the outlet and product availability are confirmed.
        </p>
      </aside>

      <div class="content-grid">
        <article class="content-card">
          <div class="content-card__icon">M</div>
          <h3>Markets</h3>
          <p>Dates, hours, and direct event links will be posted when attendance is confirmed.</p>
        </article>
        <article class="content-card">
          <div class="content-card__icon">S</div>
          <h3>Stockists</h3>
          <p>Retail partners will include a location link and a note about which bars they normally carry.</p>
        </article>
        <article class="content-card">
          <div class="content-card__icon">P</div>
          <h3>Pickup</h3>
          <p>Local pickup will be offered by appointment through Square checkout. The exact address follows a confirmed order.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <Newsletter heading="Get market dates without stalking social media" compact />
    </div>
  </section>
</BaseLayout>
