---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
import { isPublicHttpsUrl } from '../../data/site';

const storeUrl = import.meta.env.PUBLIC_SQUARE_STORE_URL;
const hasStore = isPublicHttpsUrl(storeUrl);
---

<BaseLayout
  title="Soap collection"
  description="Explore the six-bar Red Mountain Soap collection, inspired by the desert landscapes and high country of Southern Utah."
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">The opening collection</p>
      <h1>Six bars. No shelf clutter.</h1>
      <p>
        Place-based scents, a pair of goat-milk bars, and one deliberately quiet fragrance-free option.
      </p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell">
      {
        !hasStore && (
          <aside class="catalog-notice" aria-label="Shop launch status">
            <p>
              <strong>Catalog preview:</strong> Online checkout will open after finished weights,
              ingredient panels, taxes, shipping, and available stock have been verified in Square.
            </p>
          </aside>
        )
      }

      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>

      <div class="shop-actions">
        <p>
          Square will show the final price, available quantity, pickup options, and shipping terms.
        </p>
        {
          hasStore ? (
            <a class="button" href={storeUrl} rel="external">Continue to secure checkout</a>
          ) : (
            <a class="button button--secondary" href="/contact/#updates">Get the launch note</a>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--clay">
    <div class="shell split-grid">
      <div>
        <p class="eyebrow">Shipping without nonsense</p>
        <h2>Bundles make better travelers.</h2>
        <p class="lede">
          Single bars make sense at markets and for local pickup. Shipped orders will emphasize bundles so more of the money goes toward soap and less toward moving a tiny box across the country.
        </p>
      </div>
      <div class="content-card">
        <h3>What checkout will make clear</h3>
        <ul class="detail-list">
          <li>Finished weight and complete ingredient panel</li>
          <li>What is in stock and ready to leave the cure rack</li>
          <li>Shipping, pickup-by-appointment, and return terms</li>
          <li>Taxes and secure payment handled by Square</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <Newsletter heading="Want the note when checkout opens?" compact />
    </div>
  </section>
</BaseLayout>
