---
import type { Product } from '../data/products';
import ProductMark from './ProductMark.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="product-card">
  <a class="product-card__visual" href={`/soap/${product.slug}/`} tabindex="-1" aria-hidden="true">
    <ProductMark product={product} compact />
  </a>
  <div class="product-card__body">
    <p class="eyebrow">{product.subtitle}</p>
    <h3><a href={`/soap/${product.slug}/`}>{product.name}</a></h3>
    <p>{product.shortStory}</p>
    <a class="text-link" href={`/soap/${product.slug}/`}>
      Meet this bar <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
