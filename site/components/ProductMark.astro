---
import type { Product } from '../data/products';

interface Props {
  product: Product;
  compact?: boolean;
}

const { product, compact = false } = Astro.props;
---

<div
  class:list={['product-mark', `product-mark--${product.family}`, { 'product-mark--compact': compact }]}
  aria-hidden="true"
>
  <span class="product-mark__sun"></span>
  <span class="product-mark__mesa product-mark__mesa--back"></span>
  <span class="product-mark__mesa product-mark__mesa--front"></span>
  <span class="product-mark__bar"></span>
</div>
